GRAMATICA ATRIBUIDA LVALUE -> LValue se ponen en expressions (se comprueba si el assigment y el input estan bien)

G:
    // Expressions
    (1) ArithmeticOperation:    expr1       -> expr2 (+|-|*|/|%) expr3
    (2) ArrayAccess:            expr1       -> expr2 expr3
    (3) Cast:                   expr1       -> type expr2
    (4) CharLiteral:            expr        -> CHAR_CONSTANT
    (5) ComparationOp:          expr1       -> expr2 (>= | <= | > | < | == | !=) expr3
    (6) FieldAccess:            expr1       -> expr2 ID
    (7) IntLiteral:             expr        -> INT_CONSTANT
    (8) Invocation:             expr1       -> expr2 expr3*
    (9) LogicOperation:         expr1       -> expr2 (&& | ||) expr3
    (10)RealLiteral:            expr        -> REAL_CONSTANT
    (11)UnaryMinus:             expr1       -> expr2
    (12)UnaryNot:               expr1       -> expr2
    (13)Variable:               expr        -> ID

    // Statement
    (14)Assigment:             stmt        -> expr1 expr2
    (15)Input:                 stmt        -> expr

A = {exp.lvalue : boolean}

R:
    // ArithmeticOperation:    expr1 -> expr2 (+|-|*|/|%) expr3
    expr1.lvalue = false

    // ArrayAccess:            expr1 -> expr2 expr3
    expr1.lvalue = true

    // Cast:                   expr1 -> type expr2
    expr1.lvalue = false

    // CharLiteral:            expr  -> CHAR_CONSTANT
    expr.lvalue = false

    // ComparationOp:          expr1  -> expr2 (>= | <= | > | < | == | !=) expr3
    expr1.lvalue = false

    // FieldAccess:            expr1       -> expr2 ID
    expr1.lvalue = true

    // IntLiteral:             expr        -> INT_CONSTANT
    expr.lvalue = false

    // Invocation:             expr1       -> expr2 expr3*
    expr.lvalue = false

    // LogicOperation:         expr1       -> expr2 (&& | ||) expr3
    expr1.lvalue = false

    // RealLiteral:            expr        -> REAL_CONSTANT
    expr1.lvalue = false

    // UnaryMinus:             expr1       -> expr2
    expr1.lvalue = false

    // UnaryNot:               expr1       -> expr2
    expr1.lvalue = false

    // Variable:               expr        -> ID
    expr.lvalue = true


    // Assigment:              stmt        -> expr1 expr2
    if(!expr1.lvalue)
        ErrorType("El lado izquierdo de la asignación no es direccionable (lvalue))

    // Input:                  stmt        -> expr
    if(!expr.lvalue)
        ErrorType("La expresión del input debe ser direccionable (lvalue))